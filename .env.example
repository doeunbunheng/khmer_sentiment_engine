# API keys and secrets — copy to .env and fill in
HF_TOKEN=hf_your_token_here
GOOGLE_TRANSLATE_KEY=your_key_here

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=khmer_sentiment
DB_USER=postgres
DB_PASSWORD=postgres

# API security — REQUIRED before starting the server
# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET=change_me_to_a_long_random_string

# CORS — comma-separated list of frontend origins (never use *)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional overrides (defaults shown)
# API_TOKEN_TTL=86400            # token lifetime, seconds (24h)
# API_LOGIN_LIMIT=5/minute       # /auth/login per IP
# API_PREDICT_LIMIT=120/minute   # /predict per IP
# API_MAX_LOGIN_ATTEMPTS=5       # failures before lockout
# API_LOCKOUT_SECONDS=900        # lockout duration (15 min)

# Dashboard — optional AI agent (OpenAI-compatible chat completions).
# Leave AGENT_API_URL / AGENT_API_KEY empty to use the deterministic offline
# explainer.
# AGENT_API_URL=https://api.openai.com/v1
# AGENT_API_KEY=
# AGENT_MODEL=gpt-4o-mini
